---
layout: base.njk
title: Piemonte Brokers
---
<section id="inicio" class="hero" style="background-image:linear-gradient(95deg,rgba(5,21,15,.76),rgba(5,21,15,.18)),url('{{ site.imagemHome }}')">
  <div class="container hero-content">
    <p class="eyebrow">PIEMONTE BROKERS • CURADORIA IMOBILIÁRIA</p>
    <h1>{{ site.tituloHome }}</h1>
    <p>{{ site.subtituloHome }}</p>
    <div class="hero-actions">
      <a class="btn gold" href="#portfolio">Explorar portfólio</a>
      <a class="btn ghost" href="#anuncie">Quero anunciar</a>
    </div>
  </div>
</section>

<section class="search-section">
  <div class="container">
    <form id="filtros" class="search-box">
      <select id="fCategoria"><option value="">Imóveis e áreas</option><option value="imovel">Imóvel</option><option value="area">Área</option></select>
      <select id="fNegocio"><option value="">Comprar ou alugar</option><option>Venda</option><option>Locação</option></select>
      <input id="fCidade" placeholder="Cidade ou região">
      <select id="fTipo"><option value="">Todos os tipos</option></select>
      <select id="fPreco">
        <option value="">Qualquer valor</option>
        <option value="1000000">Até R$ 1 mi</option>
        <option value="3000000">Até R$ 3 mi</option>
        <option value="5000000">Até R$ 5 mi</option>
        <option value="10000000">Até R$ 10 mi</option>
        <option value="50000000">Até R$ 50 mi</option>
      </select>
      <button class="btn gold" type="submit">Buscar</button>
    </form>
  </div>
</section>

<section id="portfolio" class="section">
  <div class="container">
    <div class="section-head">
      <div><p class="eyebrow dark">PORTFÓLIO</p><h2>Oportunidades selecionadas</h2></div>
      <span id="contador" class="counter"></span>
    </div>
    <div id="cards" class="cards">
      {% for item in collections.portfolio %}
      <article class="card"
        data-categoria="{{ item.data.tipoConteudo }}"
        data-negocio="{{ item.data.negocio }}"
        data-cidade="{{ item.data.cidade }} {{ item.data.regiao }}"
        data-tipo="{{ item.data.tipo }}"
        data-preco="{{ item.data.preco or 0 }}">
        <a href="{{ item.url }}">
          <div class="card-img">
            <img src="{{ item.data.imagemCapa }}" alt="{{ item.data.titulo }}">
            <span class="badge">{{ "Área" if item.data.tipoConteudo == "area" else "Imóvel" }}</span>
          </div>
          <div class="card-body">
            <div class="meta">{{ item.data.cidade }}{% if item.data.regiao %} • {{ item.data.regiao }}{% endif %}</div>
            <h3>{{ item.data.titulo }}</h3>
            <p>
              {% if item.data.suites %}{{ item.data.suites }} suítes • {% endif %}
              {% if item.data.areaConstruida %}{{ item.data.areaConstruida }} m² construídos • {% endif %}
              {% if item.data.areaTerreno %}{{ item.data.areaTerreno }} m² de área{% endif %}
            </p>
            <strong class="price">{{ item.data.precoTexto or "Consulte" }}</strong>
          </div>
        </a>
      </article>
      {% endfor %}
    </div>
    <p id="vazio" class="empty" hidden>Nenhuma oportunidade encontrada com estes filtros.</p>
  </div>
</section>

<section id="areas" class="section dark-section">
  <div class="container split">
    <div><p class="eyebrow">ÁREAS & NEGÓCIOS</p><h2>Ativos para investidores e desenvolvedores.</h2></div>
    <div><p>Áreas para incorporação, loteamentos, ativos comerciais, propriedades rurais e oportunidades off-market.</p><a href="#parcerias" class="text-link light">Apresentar uma oportunidade →</a></div>
  </div>
</section>

<section id="sobre" class="section">
  <div class="container split">
    <div><p class="eyebrow dark">SOBRE A PIEMONTE</p><h2>Relacionamento, curadoria e apresentação profissional.</h2></div>
    <div class="prose"><p>{{ site.textoSobre }}</p></div>
  </div>
</section>

<section id="anuncie" class="section warm">
  <div class="container form-layout">
    <div>
      <p class="eyebrow dark">ANUNCIE CONOSCO</p>
      <h2>Quer vender ou disponibilizar seu imóvel?</h2>
      <p>Envie as informações iniciais. Nossa equipe entrará em contato para avaliar o ativo e conversar sobre estratégia comercial e apresentação.</p>
    </div>
    <form name="anuncie-conosco" method="POST" data-netlify="true" class="lead-form">
      <input type="hidden" name="form-name" value="anuncie-conosco">
      <input name="nome" placeholder="Nome" required>
      <input name="whatsapp" placeholder="WhatsApp" required>
      <input name="email" type="email" placeholder="E-mail">
      <select name="tipo"><option>Tipo do ativo</option><option>Casa</option><option>Apartamento</option><option>Terreno</option><option>Área</option><option>Fazenda / Sítio</option><option>Comercial</option><option>Outro</option></select>
      <input name="cidade" placeholder="Cidade / região">
      <input name="valor" placeholder="Valor pretendido">
      <textarea name="descricao" placeholder="Conte um pouco sobre o imóvel ou área"></textarea>
      <button class="btn dark-btn" type="submit">Solicitar contato</button>
    </form>
  </div>
</section>

<section id="parcerias" class="section">
  <div class="container form-layout">
    <div>
      <p class="eyebrow dark">PARCERIAS</p>
      <h2>Corretores, incorporadoras e parceiros de negócios.</h2>
      <p>Tem uma oportunidade, cliente comprador, área, empreendimento ou ativo que faça sentido para a Piemonte? Fale conosco.</p>
    </div>
    <form name="parcerias" method="POST" data-netlify="true" class="lead-form bordered">
      <input type="hidden" name="form-name" value="parcerias">
      <input name="nome" placeholder="Nome / empresa" required>
      <input name="whatsapp" placeholder="WhatsApp" required>
      <input name="email" type="email" placeholder="E-mail">
      <select name="perfil"><option>Perfil da parceria</option><option>Corretor / imobiliária</option><option>Incorporadora / loteadora</option><option>Investidor</option><option>Proprietário</option><option>Outro</option></select>
      <textarea name="mensagem" placeholder="Descreva a oportunidade ou parceria"></textarea>
      <button class="btn dark-btn" type="submit">Falar sobre parceria</button>
    </form>
  </div>
</section>

<section id="contato" class="section contact">
  <div class="container split">
    <div><p class="eyebrow">CONTATO</p><h2>Vamos conversar?</h2></div>
    <div><p>Atendimento personalizado para compra, venda, captação e parcerias imobiliárias.</p>
      {% if site.whatsapp %}<a class="btn gold" href="https://wa.me/{{ site.whatsapp }}">WhatsApp</a>{% else %}<a class="btn gold" href="#anuncie">Entrar em contato</a>{% endif %}
    </div>
  </div>
</section>